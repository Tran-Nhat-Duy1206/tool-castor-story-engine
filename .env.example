# Castor Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, custom)
CASTOR_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
CASTOR_LLM_BASE_URL=https://api.openai.com/v1

# API Key
CASTOR_LLM_API_KEY=sk-your-key-here

# Model name
CASTOR_LLM_MODEL=gpt-4o

# Notifications (optional)
CASTOR_TELEGRAM_BOT_TOKEN=
CASTOR_TELEGRAM_CHAT_ID=
CASTOR_FEISHU_WEBHOOK_URL=
CASTOR_WECOM_WEBHOOK_URL=
